NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# service_role key — nunca prefixar com NEXT_PUBLIC_, nunca expor ao client.
# Só usada em server actions que já verificaram admin (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only — nunca prefixar com NEXT_PUBLIC_. Usada em src/lib/actions/vision-ai.ts
# para a análise de fotos do Trolesi Vision AI (Google Gemini, tier gratuito).
# Gerar em https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-only — nunca prefixar com NEXT_PUBLIC_. Segredo compartilhado com o Postgres (tabela
# public.segredos_sistema, só o hash fica no banco) pra carimbar_ip_auditoria() confiar no IP real
# do usuário (audit_log.ip_cliente). Gerar com `openssl rand -hex 32`; mesmo valor precisa estar
# configurado local e na Vercel — ver migration 20260924000003_auditoria_ip_confiavel.sql.
AUDIT_IP_SHARED_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
