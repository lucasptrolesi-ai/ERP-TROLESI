# Copie pra ".env" nesta mesma pasta e preencha com os valores reais
# (mesmos do .env.local do app principal — Project Settings > API no
# Supabase). Nunca commitar o ".env" de verdade.

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Como entregar o cupom pra impressora térmica (2026-08-31):
# "rede" (padrão) — máquina Windows com a Elgin i8 compartilhada.
# "usb"  — Elgin i8 ligada direto nesta máquina (Mac ou qualquer outra),
#          escreve o buffer ESC/POS direto na porta USB, sem driver/CUPS.
MODO_IMPRESSAO_CUPOM=rede

# Nome do compartilhamento da impressora no Windows (Painel de Controle >
# Dispositivos e Impressoras > botão direito > Propriedades > Compartilhamento).
# Só usado no modo "rede".
IMPRESSORA_COMPARTILHAMENTO=ELGIN i8

# Só usado no modo "usb" — vendor/product ID da impressora (descubra com
# `ioreg -p IOUSB -l -w 0 | grep -A2 idVendor` no Mac, com ela conectada;
# valores em decimal ou hex "0x..." — a Elgin i8 testada é 0x1fc9/0x2016).
IMPRESSORA_CUPOM_VENDOR_ID=0x1fc9
IMPRESSORA_CUPOM_PRODUCT_ID=0x2016

# Pasta onde o comprovante em PDF de cada venda é salvo (organizado em
# <ano>/<mes>/Cliente - DD-MM.pdf), pra encaminhar manualmente pro cliente
# via WhatsApp. Default: pasta "Comprovante" na área de trabalho do usuário
# que roda o agente.
PASTA_COMPROVANTES=C:\Users\Micro\Desktop\Comprovante
